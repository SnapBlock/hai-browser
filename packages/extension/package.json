{
  "name": "hai-browser",
  "displayName": "H/Ai Browser",
  "description": "Share VS Code's integrated browser with Claude Code and other MCP agents.",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#1e1b2e", "theme": "dark" },
  "keywords": ["claude", "claude code", "mcp", "browser", "agent", "ai", "react", "vite", "next.js", "computer use"],
  "preview": true,
  "pricing": "Free",
  "version": "0.0.1",
  "publisher": "snapblock",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SnapBlock/hai-browser" },
  "homepage": "https://github.com/SnapBlock/hai-browser#readme",
  "bugs": { "url": "https://github.com/SnapBlock/hai-browser/issues" },
  "engines": { "vscode": "^1.119.0" },
  "categories": ["AI", "Debuggers", "Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["ms-vscode.js-debug"],
  "contributes": {
    "commands": [
      { "command": "haiBrowser.share", "title": "Share Browser Tab with Agent", "category": "H/Ai" },
      { "command": "haiBrowser.pickElement", "title": "Pick Element and Open Source", "category": "H/Ai", "icon": "$(inspect)" },
      { "command": "haiBrowser.stopSharing", "title": "Stop Sharing Browser Tab", "category": "H/Ai" },
      { "command": "haiBrowser.connectClaude", "title": "Connect Claude Code", "category": "H/Ai" },
      { "command": "haiBrowser.showConnectionInfo", "title": "Show MCP Setup", "category": "H/Ai" }
    ],
    "configuration": {
      "title": "H/Ai Browser",
      "properties": {
        "haiBrowser.allowEvaluate": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow agents to run arbitrary JavaScript in the shared page (`browser_evaluate`)."
        },
        "haiBrowser.showAgentCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a pointer in the shared page that moves to where the agent clicks, hovers, drags and types. It is hidden from the agent's screenshots."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap && pnpm run build:mcp",
    "build:mcp": "esbuild ../mcp/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/mcp.mjs --minify --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo 'no unit tests yet'",
    "package": "vsce package --no-dependencies -o hai-browser.vsix"
  },
  "dependencies": {
    "@hai-browser/protocol": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.118.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.0.0"
  }
}
