{
  "name": "hai-browser-mcp",
  "version": "0.0.1",
  "description": "MCP server that lets Claude Code and other agents drive the browser tab shared from VS Code via the H/Ai extension.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/SnapBlock/hai-browser" },
  "type": "module",
  "bin": { "hai-browser-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --external:@modelcontextprotocol/sdk --external:ws --external:zod",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pick": "node scripts/pick-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hai-browser/protocol": "workspace:*",
    "@types/ws": "^8.18.2"
  }
}
